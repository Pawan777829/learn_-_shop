
/**
 * @fileoverview Firestore Security Rules for the Learn & Shop platform.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user-specific data
 * and leverages Authorization Independence by denormalizing ownership data
 * within documents. Public read access is not granted to any collection in
 * this prototyping phase.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles.
 * - /users/{userId}/vendors/{vendorId}: Stores vendor profiles owned by the user.
 * - /users/{userId}/addresses/{addressId}: Stores user shipping addresses.
 * - /vendors/{vendorId}/products/{productId}: Stores products listed by vendors.
 * - /vendors/{vendorId}/courses/{courseId}: Stores courses offered by vendors.
 * - /users/{userId}/orders/{orderId}: Stores order information for users.
 * - /users/{userId}/orders/{orderId}/orderItems/{orderItemId}: Stores order items associated with an order.
 * - /users/{userId}/enrollments/{enrollmentId}: Stores enrollment information for users.
 * - /users/{userId}/recommendations/{recommendationId}: Stores recommendations for users.
 * - /courses/{courseId}/lessons/{lessonId}: Stores lessons associated with courses.
 * - /products/{productId}/reviews/{reviewId}: Stores reviews for products.
 * - /courses/{courseId}/reviews/{reviewId}: Stores reviews for courses.
 * - /users/{userId}/wishlist/{wishlistItemId}: Stores items on a user's wishlist.
 *
 * Key Security Decisions:
 * - All write operations are restricted to authenticated users.
 * - User-specific data is strictly controlled by user ID matching the auth UID.
 * - Authorization Independence is achieved by including ownership data (e.g., vendorId, userId)
 *   directly within documents, avoiding costly `get()` calls in rules.
 * - No public read access is granted in this prototyping phase.
 *
 * Denormalization for Authorization:
 * - The `Product` and `Course` entities denormalize the `vendorId` to allow direct
 *   authorization checks without needing to query the parent `Vendor` document.
 * - The `Order`, `Enrollment`, and `Recommendation` entities denormalize the `userId`
 *   for similar reasons.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /**
     * @description Enforces user-ownership for user profiles.
     * @path /users/{userId}
     * @allow (get, update) - Authenticated user with matching user ID can read or update their profile.
     * @allow (create) - Authenticated user creates their own profile with matching user ID.
     * @deny (delete) - Users cannot delete their own profiles.
     */
    match /users/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
    }
    
    /**
     * @description Enforces user-ownership for addresses.
     * @path /users/{userId}/addresses/{addressId}
     * @allow (read, write) - Authenticated user with matching user ID can manage their addresses.
     */
    match /users/{userId}/addresses/{addressId} {
      allow read, write: if isOwner(userId);
    }

    /**
     * @description Enforces user-ownership for vendor profiles.
     * @path /users/{userId}/vendors/{vendorId}
     * @allow (read, write) - Authenticated user with matching user ID can manage their vendor profile.
     */
    match /users/{userId}/vendors/{vendorId} {
      allow read, write: if isOwner(userId);
    }

    /**
     * @description Publicly readable products, but write access is restricted to the owning vendor.
     * @path /vendors/{vendorId}/products/{productId}
     * @principle Enforces document ownership for writes. Authorization Independence achieved via denormalized vendorId on Product.
     */
    match /vendors/{vendorId}/products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)/vendors/$(vendorId)).data.userId == request.auth.uid;
    }
    
    /**
     * @description Publicly readable reviews. Writes are restricted.
     * @path /products/{productId}/reviews/{reviewId}
     */
    match /products/{productId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    /**
     * @description Publicly readable courses, but write access is restricted to the owning vendor.
     * @path /vendors/{vendorId}/courses/{courseId}
     * @principle Enforces document ownership for writes. Authorization Independence achieved via denormalized vendorId on Course.
     */
    match /vendors/{vendorId}/courses/{courseId} {
        allow read: if true;
        allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)/vendors/$(vendorId)).data.userId == request.auth.uid;
    }
    
    /**
     * @description Publicly readable reviews. Writes are restricted to enrolled users.
     * @path /courses/{courseId}/reviews/{reviewId}
     */
    match /courses/{courseId}/reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)/enrollments/$(courseId));
    }

    /**
     * @description Enforces user-ownership for orders and their subcollections.
     * @path /users/{userId}/orders/{orderId}
     * @principle Enforces document ownership for writes. Authorization Independence achieved via denormalized userId on Order.
     */
    match /users/{userId}/orders/{orderId} {
      allow read, write: if isOwner(userId);

      // Rule for the orderItems subcollection
      match /orderItems/{orderItemId} {
        allow read, write: if isOwner(userId);
      }
    }

    /**
     * @description Enforces user-ownership for enrollments.
     * @path /users/{userId}/enrollments/{enrollmentId}
     * @principle Enforces document ownership for writes. Authorization Independence achieved via denormalized userId on Enrollment.
     */
    match /users/{userId}/enrollments/{enrollmentId} {
      allow read, write: if isOwner(userId);
    }

    /**
     * @description Enforces user-ownership for recommendations.
     * @path /users/{userId}/recommendations/{recommendationId}
     * @principle Enforces document ownership for writes. Authorization Independence achieved via denormalized userId on Recommendation.
     */
    match /users/{userId}/recommendations/{recommendationId} {
      allow read, write: if isOwner(userId);
    }

    /**
     * @description Lesson access is restricted to enrolled users or the course vendor.
     * @path /courses/{courseId}/lessons/{lessonId}
     */
    match /courses/{courseId}/lessons/{lessonId} {
       function isEnrolled() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid)/enrollments/$(courseId));
      }

      function isCourseVendor() {
        // This rule assumes vendorId is denormalized on the course document.
        let courseDoc = get(/databases/$(database)/documents/courses/$(courseId));
        return courseDoc.data.vendorId == request.auth.uid;
      }

      allow read: if request.auth != null && (isEnrolled() || isCourseVendor());
      allow write: if request.auth != null && isCourseVendor();
    }
    
    /**
     * @description Enforces user-ownership for their wishlist.
     * @path /users/{userId}/wishlist/{wishlistItemId}
     */
    match /users/{userId}/wishlist/{wishlistItemId} {
      allow read, write: if isOwner(userId);
    }
  }
}
